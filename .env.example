# SANKET AI configuration. Copy to `.env` and adjust. Never commit a real `.env`.

# --- Data locations (relative paths are resolved against the project folder) -------------
# Folders searched (not recursively) for the two SANKET PDFs, separated by ';'.
SANKET_PDF_DIRS=data/raw;.
SANKET_PROCESSED_DIR=data/processed
# Structured database and vector store (default: inside SANKET_PROCESSED_DIR).
# SANKET_DB_PATH=data/processed/sanket.sqlite3
# SANKET_VECTOR_DIR=data/processed/chroma
# Curated spelling-variant map applied during ingestion.
SANKET_ALIAS_FILE=config/mine_aliases.json
# Optional verified external context (geology, hydrology, regulations). JSON files, see README.
SANKET_CONTEXT_DIR=data/context

# --- Retrieval ----------------------------------------------------------------------------
# onnx-minilm = local embeddings (all-MiniLM-L6-v2 via onnxruntime; ~90 MB model downloaded once).
# none        = keyword retrieval only.
SANKET_EMBEDDING_BACKEND=onnx-minilm

# --- Language model -----------------------------------------------------------------------
# offline    = no model call; plans come from the rule engine and the chat shows passages only.
# groq       = Groq Cloud (key in GROQ_API_KEY). Default model openai/gpt-oss-120b.
# openrouter = OpenRouter (key in OPENROUTER_API_KEY). Default model nvidia/nemotron-3-super-120b-a12b:free.
# anthropic  = Claude via the Anthropic API.  openai = OpenAI or a compatible server.
# ollama     = local model served by Ollama (data stays on your network).
SANKET_LLM_PROVIDER=offline
# Model for the primary provider (blank = that provider's default).
SANKET_LLM_MODEL=
# Providers tried in order when the primary fails before answering (bad key, rate limit, outage).
SANKET_LLM_FALLBACK_PROVIDERS=
# Per-provider overrides for fallbacks, e.g. SANKET_OPENROUTER_MODEL, SANKET_GROQ_MODEL.
SANKET_OPENROUTER_MODEL=
# NAME of the variable holding the primary provider's key (blank = GROQ_API_KEY, OPENROUTER_API_KEY,
# ANTHROPIC_API_KEY or OPENAI_API_KEY as appropriate). Put the keys themselves below.
SANKET_LLM_API_KEY_ENV=
# GROQ_API_KEY=your-groq-key
# OPENROUTER_API_KEY=your-openrouter-key
# Base URL for Ollama or an OpenAI-compatible server (OpenRouter's is set automatically).
SANKET_LLM_BASE_URL=
SANKET_LLM_MAX_TOKENS=8000
SANKET_LLM_TIMEOUT_S=180

# External providers receive passages retrieved from the PDFs. They stay blocked until this is
# set to true on purpose.
SANKET_ALLOW_EXTERNAL_LLM=false
# Remove victims' names from the evidence sent to a model for emergency plans.
SANKET_REDACT_PERSON_NAMES=true

# --- Document chat (floating "Ask SANKET" chatbot) -------------------------------------------
# Model for the chat (default: SANKET_LLM_MODEL / provider default).
SANKET_CHAT_MODEL=
# Reasoning effort for reasoning models (gpt-oss, gpt-5.x, o-series): low|medium|high.
SANKET_CHAT_REASONING_EFFORT=low
# Largest share of an answer that may be labelled general knowledge rather than the PDFs.
SANKET_CHAT_MAX_GENERAL_SHARE=0.20
# Number of PDF passages retrieved per question.
SANKET_CHAT_PASSAGES=8
# Check every claim against the passages before showing an answer (strongly recommended).
SANKET_CHAT_VERIFY=true
# How many times to redraft when too little of an answer survives verification.
SANKET_CHAT_MAX_REGENERATIONS=1
# Abuse protection: questions per user per minute, and maximum question length.
SANKET_CHAT_RATE_LIMIT_PER_MIN=12
SANKET_CHAT_MAX_MESSAGE_CHARS=2000
# Chat history, memory notes and the local cache are stored here (not in the rebuildable index).
SANKET_CHAT_DIR=data/chat
# Optional Redis cache (e.g. redis://localhost:6379/0). Blank = local SQLite cache file.
SANKET_REDIS_URL=
SANKET_CACHE_TTL_S=86400
# Shared secret for the HTTP API (uvicorn src.api:app). The API refuses all requests while blank.
SANKET_API_TOKEN=

SANKET_LOG_LEVEL=INFO
